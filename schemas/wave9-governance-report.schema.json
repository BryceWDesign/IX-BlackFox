{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ix-blackfox.local/schemas/wave9-governance-report.schema.json",
  "title": "IX-BlackFox Wave 9 Governance Report",
  "description": "Schema contract for deterministic Wave 9 governance reports. This validates audit-attestation report shape only; it does not certify production readiness, ATO/cATO, DoD approval, procurement readiness, or autonomous authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave",
    "run_id",
    "generated_at",
    "disposition",
    "attestation_subject_digest",
    "subject",
    "policy_pack",
    "evidence_manifest",
    "evidence_validation",
    "control_evaluation",
    "signoff_validation",
    "signoff_authority",
    "reviewer_signoffs",
    "claims",
    "non_claims",
    "standards_alignment",
    "metadata",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "wave9.compliance_audit_attestation.v1"
    },
    "wave": {
      "const": 9
    },
    "run_id": {
      "$ref": "#/$defs/safe_identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "disposition": {
      "$ref": "#/$defs/disposition"
    },
    "attestation_subject_digest": {
      "$ref": "#/$defs/sha256"
    },
    "subject": {
      "$ref": "#/$defs/audit_subject"
    },
    "policy_pack": {
      "$ref": "#/$defs/policy_pack"
    },
    "evidence_manifest": {
      "$ref": "#/$defs/evidence_manifest"
    },
    "evidence_validation": {
      "$ref": "#/$defs/evidence_validation"
    },
    "control_evaluation": {
      "$ref": "#/$defs/control_evaluation"
    },
    "signoff_validation": {
      "$ref": "#/$defs/signoff_validation"
    },
    "signoff_authority": {
      "$ref": "#/$defs/signoff_authority"
    },
    "reviewer_signoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewer_signoff"
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "non_claims": {
      "$ref": "#/$defs/non_claims"
    },
    "standards_alignment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standards_mapping_with_control"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "report_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "audit_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository",
        "head_sha",
        "scope",
        "changed_paths",
        "metadata",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "const": "wave9.attestation_subject.v1"
        },
        "repository": {
          "$ref": "#/$defs/safe_identifier"
        },
        "head_sha": {
          "$ref": "#/$defs/non_empty_string"
        },
        "scope": {
          "$ref": "#/$defs/non_empty_string"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository_relative_path"
          },
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "policy_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pack_id",
        "version",
        "title",
        "description",
        "control_count",
        "controls",
        "non_claims",
        "metadata",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "const": "wave9.policy_pack.v1"
        },
        "pack_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "control_count": {
          "type": "integer",
          "minimum": 1
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control_requirement"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "non_claims": {
          "$ref": "#/$defs/non_claims"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_id",
        "subject",
        "generated_at",
        "artifact_count",
        "artifacts",
        "metadata",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "const": "wave9.evidence_manifest.v1"
        },
        "manifest_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "subject": {
          "$ref": "#/$defs/audit_subject"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          },
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "source_wave",
        "path",
        "sha256",
        "size_bytes",
        "producer",
        "head_sha",
        "schema_version",
        "verified",
        "metadata"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "kind": {
          "$ref": "#/$defs/evidence_kind"
        },
        "source_wave": {
          "$ref": "#/$defs/evidence_source_wave"
        },
        "path": {
          "$ref": "#/$defs/repository_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "producer": {
          "$ref": "#/$defs/non_empty_string"
        },
        "head_sha": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "evidence_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "is_valid",
        "issue_count",
        "blocking_issue_count",
        "warning_issue_count",
        "issues",
        "metadata"
      ],
      "properties": {
        "manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "is_valid": {
          "type": "boolean"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_validation_issue"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "control_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_pack_digest",
        "evidence_manifest_digest",
        "disposition",
        "finding_count",
        "blocked_count",
        "warning_count",
        "not_applicable_count",
        "findings",
        "metadata",
        "digest"
      ],
      "properties": {
        "policy_pack_digest": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable_count": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control_finding"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signoff_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_digest",
        "policy_pack_digest",
        "is_valid",
        "has_authoritative_human_approval",
        "issue_count",
        "blocking_issue_count",
        "warning_issue_count",
        "authoritative_human_approval_ids",
        "advisory_signoff_ids",
        "issues",
        "metadata"
      ],
      "properties": {
        "subject_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_pack_digest": {
          "$ref": "#/$defs/sha256"
        },
        "is_valid": {
          "type": "boolean"
        },
        "has_authoritative_human_approval": {
          "type": "boolean"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "authoritative_human_approval_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          },
          "uniqueItems": true
        },
        "advisory_signoff_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signoff_validation_issue"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "signoff_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_digest",
        "policy_pack_digest",
        "signoff_count",
        "has_authoritative_human_approval",
        "authoritative_human_approval_ids",
        "advisory_signoff_ids",
        "non_authoritative_approval_ids",
        "validation_digest"
      ],
      "properties": {
        "subject_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_pack_digest": {
          "$ref": "#/$defs/sha256"
        },
        "signoff_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_authoritative_human_approval": {
          "type": "boolean"
        },
        "authoritative_human_approval_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          },
          "uniqueItems": true
        },
        "advisory_signoff_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          },
          "uniqueItems": true
        },
        "non_authoritative_approval_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          },
          "uniqueItems": true
        },
        "validation_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewer_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signoff_id",
        "reviewer_id",
        "reviewer_kind",
        "decision",
        "subject_digest",
        "policy_pack_digest",
        "signed_at",
        "role",
        "notes",
        "is_authoritative_human_approval",
        "metadata"
      ],
      "properties": {
        "signoff_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "reviewer_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "reviewer_kind": {
          "type": "string",
          "enum": [
            "human",
            "system",
            "model"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "changes_requested",
            "rejected",
            "commented"
          ]
        },
        "subject_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_pack_digest": {
          "$ref": "#/$defs/sha256"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "notes": {
          "type": "string"
        },
        "is_authoritative_human_approval": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "control_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "title",
        "objective",
        "severity",
        "required_evidence_kinds",
        "standards_mappings",
        "metadata"
      ],
      "properties": {
        "control_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "required_evidence_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_kind"
          }
        },
        "standards_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standards_mapping"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "control_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "status",
        "severity",
        "summary",
        "evidence_artifact_ids",
        "remediation",
        "blocks_audit_ready",
        "metadata"
      ],
      "properties": {
        "control_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "warning",
            "blocked",
            "not_applicable"
          ]
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          },
          "uniqueItems": true
        },
        "remediation": {
          "type": "string"
        },
        "blocks_audit_ready": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "evidence_validation_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "severity",
        "summary",
        "artifact_id",
        "remediation",
        "blocks_audit_ready",
        "metadata"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact_id": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "blocks_audit_ready": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "signoff_validation_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "severity",
        "summary",
        "signoff_id",
        "remediation",
        "blocks_audit_ready",
        "metadata"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "signoff_id": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "blocks_audit_ready": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "standards_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference_id",
        "summary",
        "claim",
        "metadata"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/standards_mapping_kind"
        },
        "reference_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim": {
          "$ref": "#/$defs/non_empty_string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "standards_mapping_with_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "kind",
        "reference_id",
        "summary",
        "claim",
        "metadata"
      ],
      "properties": {
        "control_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "kind": {
          "$ref": "#/$defs/standards_mapping_kind"
        },
        "reference_id": {
          "$ref": "#/$defs/safe_identifier"
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "claim": {
          "$ref": "#/$defs/non_empty_string"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "audit_ready",
        "warning",
        "blocked"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "blocking"
      ]
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "pr_evidence_pack",
        "ci_evidence",
        "approval_record",
        "human_review",
        "governance_receipt",
        "sandbox_receipt_bundle",
        "sandbox_adversarial_report",
        "model_repair_report",
        "model_repair_receipt",
        "repository_intelligence_report",
        "repository_evidence_snapshot",
        "policy_decision",
        "attestation",
        "governance_report",
        "other"
      ]
    },
    "evidence_source_wave": {
      "type": "string",
      "enum": [
        "wave5",
        "wave6",
        "wave7",
        "wave8",
        "wave9",
        "external",
        "unknown"
      ]
    },
    "standards_mapping_kind": {
      "type": "string",
      "enum": [
        "internal_ix_blackfox",
        "nist_ssdf",
        "oscal_assessment_results",
        "slsa_provenance",
        "in_toto_statement",
        "github_artifact_attestation",
        "dod_enterprise_devsecops",
        "other"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "repository_relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          {
            "pattern": "(^|/)\\.(/|$)"
          },
          {
            "pattern": "://"
          }
        ]
      }
    },
    "safe_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/#-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
