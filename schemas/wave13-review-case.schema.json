{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BryceWDesign/IX-BlackFox/schemas/wave13-review-case.schema.json",
  "title": "IX-BlackFox Wave 13 Review Case",
  "description": "Subject and role policy envelope for the human-machine review board.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "policy",
    "subject_digest",
    "policy_digest",
    "machine_authority",
    "human_authority_required",
    "scope_note",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "wave13.review_case.v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository",
        "revision",
        "scope",
        "producer_agent_id",
        "wave12_archive_sha256",
        "wave12_manifest_digest",
        "wave12_profile_digest",
        "admitted_at",
        "metadata",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "const": "wave13.review_board_subject.v1"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "producer_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "wave12_archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wave12_manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wave12_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "version",
        "supported_roles",
        "required_roles",
        "minimum_human_approvals",
        "require_distinct_reviewers",
        "require_each_required_role",
        "require_external_identity_verification",
        "block_on_authenticated_reject",
        "block_on_authenticated_request_changes",
        "block_on_open_challenge",
        "prevent_subject_producer_self_approval",
        "metadata",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "const": "wave13.review_board_policy.v1"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "supported_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "maintainer",
              "manufacturing",
              "operations",
              "qa",
              "safety",
              "security",
              "systems"
            ]
          },
          "minItems": 1
        },
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "maintainer",
              "manufacturing",
              "operations",
              "qa",
              "safety",
              "security",
              "systems"
            ]
          },
          "minItems": 1
        },
        "minimum_human_approvals": {
          "type": "integer",
          "minimum": 1
        },
        "require_distinct_reviewers": {
          "type": "boolean"
        },
        "require_each_required_role": {
          "type": "boolean"
        },
        "require_external_identity_verification": {
          "type": "boolean"
        },
        "block_on_authenticated_reject": {
          "type": "boolean"
        },
        "block_on_authenticated_request_changes": {
          "type": "boolean"
        },
        "block_on_open_challenge": {
          "type": "boolean"
        },
        "prevent_subject_producer_self_approval": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine_authority": {
      "const": false
    },
    "human_authority_required": {
      "const": true
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
